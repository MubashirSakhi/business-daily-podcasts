---
import { url } from '../lib';
interface Props { title?: string; description?: string; wide?: boolean; }
const { title, wide = false, description = 'A daily digest of new episodes from My First Million, Planet Money, Stuff You Should Know, What\'s Your Problem and Masters of Scale.' } = Astro.props;
const fullTitle = title ? `${title} · Podcast Daily` : 'Podcast Daily';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="alternate" type="application/rss+xml" title="Podcast Daily" href={url('rss.xml')} />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎧</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <slot name="head" />
</head>
<body class:list={{ wide }}>
  <header class="masthead">
    <a class="wordmark" href={url('')}>Podcast Daily</a>
    <nav>
      <a href={url('')}>Editions</a>
      <a href={url('tags/')}>Tags</a>
      <a href={url('topics/')}>Topics</a>
      <a href={url('search/')}>Search</a>
      <a href={url('rss.xml')}>RSS</a>
    </nav>
  </header>
  <main><slot /></main>
  <footer>
    Recaps and highlights are commentary on the original episodes. Every recap links to the show; go listen.
  </footer>
</body>
</html>

<style is:global>
  :root {
    --paper: #121214; --card: #1c1c1f; --ink: #f4f1ea; --secondary: #c4c4cc; --muted: #9a9aa3; --rule: #232326; --border: #3a3a3f;
    --accent: #ff8a5c; --orange: #ff5a1f; --lime: #b5e655; --on-dark: #121214;
    --chip: #232326; --chip-ink: #f4f1ea;
    /* show pastels: dark ink text on all of them */
    --mfm: #f4a77b; --pm: #b7cbdf; --sysk: #b5cf84; --wyp: #c6b4ea; --mos: #d6d0c4;
    /* ponytail: one face for everything; --serif kept as an alias so the inner pages needn't change */
    --sans: 'Outfit', system-ui, sans-serif; --serif: var(--sans);
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 19px/1.6 var(--serif); }
  a { color: inherit; text-decoration-color: var(--border); text-underline-offset: 3px; }
  a:hover { color: var(--accent); text-decoration-color: currentColor; }
  main { max-width: 42rem; margin: 0 auto; padding: 0 16px 64px; }

  .masthead { max-width: 42rem; margin: 0 auto 24px; padding: 22px 16px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; }
  .wordmark { font: 800 21px var(--sans); letter-spacing: -0.02em; text-decoration: none; }
  .masthead nav { display: flex; flex-wrap: wrap; gap: 18px; font: 500 15px var(--sans); }
  .masthead nav a { text-decoration: none; }
  footer { max-width: 42rem; margin: 0 auto; padding: 24px 16px 48px; border-top: 1px solid var(--rule); color: var(--muted); font: 14px/1.5 var(--sans); }

  .kicker { font: 600 12px var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); margin: 0 0 12px; }
  h1, h2 { font-family: var(--sans); font-weight: 700; }
  h1 { font-size: 2.1rem; line-height: 1.15; letter-spacing: -0.015em; margin: 0 0 12px; }
  h2 { font-size: 1.5rem; line-height: 1.2; margin: 0 0 8px; }
  h2 a { text-decoration: none; }
  h3 { font: 600 12px var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin: 28px 0 8px; }
  .lede { color: var(--muted); font-style: italic; margin: 0 0 32px; }
  .meta { font: 13px/1.5 var(--sans); color: var(--muted); }

  .badge { display: inline-block; font: 600 11px var(--sans); letter-spacing: 0.04em; text-transform: uppercase; color: var(--on-dark);
    padding: 3px 9px; border-radius: 999px; background: var(--show, var(--mos)); text-decoration: none; }
  .mfm { --show: var(--mfm); } .pm { --show: var(--pm); } .sysk { --show: var(--sysk); }
  .wyp { --show: var(--wyp); } .mos { --show: var(--mos); }
  :focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; }

  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 16px; padding: 0; list-style: none; }
  .chips li { margin: 0; }
  .chip { display: inline-block; font: 500 12px/1 var(--sans); padding: 6px 10px; border-radius: 999px; background: var(--chip);
    color: var(--chip-ink); text-decoration: none; border: 1px solid transparent; }
  .chip:hover { border-color: var(--muted); }
  .chip.tag::before { content: '#'; opacity: 0.5; margin-right: 1px; }
  .chip .n { opacity: 0.55; margin-left: 4px; }


  .hl { list-style: none; padding: 0; margin: 0; }
  .hl > li { padding: 14px 0; border-top: 1px solid var(--rule); }
  .hl > li:first-child { border-top: 0; }
  .hl .chips { margin-bottom: 0; }
  .hl .meta { margin-top: 4px; }

  .edition-head { margin-bottom: 24px; }
  .archive { list-style: none; padding: 0; margin: 0; }
  .archive > li { padding: 16px 0; border-top: 1px solid var(--rule); }
  .archive .date { font-weight: 600; text-decoration: none; }
  .archive ul { list-style: none; padding: 0; margin: 6px 0 0; font-size: 16px; }
  .archive ul li { margin: 3px 0; }
  .section-title { font: 600 13px var(--sans); letter-spacing: 0.08em; text-transform: uppercase; border-bottom: 1px solid var(--ink);
    padding-bottom: 6px; margin: 56px 0 8px; }
  .az { columns: 2; column-gap: 32px; padding: 0; list-style: none; font-size: 17px; }
  .az li { break-inside: avoid; margin: 4px 0; }
  .az .n { color: var(--muted); font: 12px var(--sans); }
  /* homepage: one 880px reading column; footer sits inside the main's 64px bottom padding */
  .wide main, .wide .masthead, .wide footer { max-width: 880px; padding-left: clamp(20px, 4vw, 40px); padding-right: clamp(20px, 4vw, 40px); }
  .wide .masthead { margin-bottom: 0; }
  .wide footer { padding-left: 0; padding-right: 0; width: calc(min(880px, 100%) - 2 * clamp(20px, 4vw, 40px)); }
  @media (max-width: 480px) { body { font-size: 18px; } h1 { font-size: 1.75rem; } .az { columns: 1; } }
</style>
