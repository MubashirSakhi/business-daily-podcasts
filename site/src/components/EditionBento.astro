---
import { getHighlights, SHOW_BADGE, slug, url } from '../lib';
type Edition = Awaited<ReturnType<typeof import('../lib').getEditions>>[number];
interface Props { latest: Edition; }
const { latest } = Astro.props;

const all = await getHighlights();
const countBy = (keys: string[]) =>
  [...keys.reduce((m, k) => m.set(k, (m.get(k) ?? 0) + 1), new Map<string, number>())].sort((a, b) => b[1] - a[1]);
const topics = countBy(all.flatMap((h) => h.topics)).slice(0, 8);
const tags = countBy(all.map((h) => h.category));

const lead = latest.episodes[0];
const quote = lead.highlights[0];
const leadShow = SHOW_BADGE[lead.show];
// feature tiles take the show pastels the hero isn't using, so no two neighbours match
const [cTopics, cTags, cSearch] = ['mfm', 'wyp', 'sysk', 'pm', 'mos'].filter((c) => c !== leadShow);
const tilt = [-8, 0, 5, 0, -4, 6, 0, -3]; // ponytail: fixed angles, not random, so builds are stable

const d = new Date(latest.date + 'T12:00:00Z');
const fmt = (o: Intl.DateTimeFormatOptions) => d.toLocaleDateString('en-US', { ...o, timeZone: 'UTC' });
---
<section class="bento" aria-label="Today on Podcast Daily">
  <article class:list={['tile', 'hero', 'dots', leadShow]}>
    <h1 class="duo"><span>{fmt({ weekday: 'long' })}</span> <a href={url(latest.path)}>{fmt({ month: 'long', day: 'numeric' })}</a></h1>
    <ul class="hero-eps">
      {latest.episodes.map((ep) => (
        <li><a href={url(ep.path)}>{ep.title}</a> <span class:list={['pill', SHOW_BADGE[ep.show]]}><i />{ep.show}</span></li>
      ))}
    </ul>
    <a class="more" href={url(latest.path)}>Read the {latest.episodes.length} recaps</a>
  </article>

  <figure class="tile quote">
    <span class:list={['pill', leadShow]}><i />{lead.show}</span>
    <blockquote>{quote.text}</blockquote>
    <figcaption><a href={url(lead.path)}>{lead.title}</a></figcaption>
  </figure>

  <nav class:list={['tile', 'dots', cTopics]} aria-labelledby="bt-topics">
    <h2 class="duo" id="bt-topics"><span>What the shows</span> keep coming back to</h2>
    <ul class="cloud">
      {topics.map(([t, n], i) => (
        <li style={`--r:${tilt[i]}deg`}><a class="pill" href={url(`topics/${slug(t)}/`)}>{t}<i />{n} highlights</a></li>
      ))}
    </ul>
  </nav>

  <nav class:list={['tile', 'dots', cTags]} aria-labelledby="bt-tags">
    <h2 class="duo" id="bt-tags"><span>Browse</span> by tag</h2>
    <ul class="cloud flat">
      {tags.map(([t, n]) => <li><a class="pill" href={url(`tags/${slug(t)}/`)}>{t}<i />{n}</a></li>)}
    </ul>
  </nav>

  <form class:list={['tile', 'search', 'dots', cSearch]} action={url('search/')} method="get" role="search">
    <h2 class="duo"><label for="bq"><span>Search every</span> recap and highlight</label></h2>
    <div class="field">
      <input id="bq" name="q" type="search" placeholder="Try “taxes” or “Mr Beast”" required />
      <button type="submit">Search</button>
    </div>
  </form>
</section>

<style>
  .bento { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: minmax(260px, auto); gap: 16px; }
  .tile { background: var(--show, var(--card)); border-radius: 28px; padding: 32px; margin: 0; display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .dots { background-image: radial-gradient(rgb(28 36 51 / 0.09) 1px, transparent 1.4px); background-size: 11px 11px; }

  .duo { font: 700 clamp(1.6rem, 2.6vw, 2.1rem)/1.15 var(--sans); letter-spacing: -0.025em; margin: 0; }
  .duo span { display: block; font-weight: 300; }
  .duo a, .duo label { text-decoration: none; color: inherit; }
  .hero .duo { font-size: clamp(2.6rem, 5.5vw, 4.4rem); line-height: 1; }

  .hero { grid-column: span 2; grid-row: span 2; justify-content: space-between; }
  .hero-eps { list-style: none; margin: 0; padding: 0; font: 400 1.15rem/1.3 var(--serif); }
  .hero-eps li { padding: 12px 0; border-top: 1px solid rgb(28 36 51 / 0.15); }
  .hero-eps li > a { text-decoration: none; margin-right: 6px; }
  .hero-eps li > a:hover { text-decoration: underline; }
  .more { font: 700 15px var(--sans); text-underline-offset: 4px; text-decoration-color: currentColor; }

  .pill { display: inline-flex; align-items: center; gap: 8px; background: #fff; color: var(--ink); border-radius: 999px;
    padding: 7px 14px; font: 600 13px/1 var(--sans); text-decoration: none; white-space: nowrap; vertical-align: middle; }
  .pill i { width: 7px; height: 7px; border-radius: 50%; background: var(--show, #c9c6be); flex: none; }
  .hero-eps .pill { font-size: 11px; padding: 5px 10px; }
  @media (min-width: 761px) { .hero-eps { font-size: 1.45rem; } .hero-eps li { padding: 16px 0; } }

  .quote { background: var(--card); border: 1px solid var(--rule); justify-content: space-between; }
  .quote .pill { align-self: flex-start; background: var(--show); }
  .quote .pill i { background: var(--ink); opacity: 0.4; }
  .quote blockquote { margin: 0; font: 400 1.2rem/1.45 var(--serif); }
  .quote blockquote::before { content: '“'; display: block; font: 800 2.4rem/0.6 var(--sans); margin-bottom: 6px; }
  .quote figcaption { font: 600 13px/1.4 var(--sans); color: var(--muted); }
  .quote figcaption a { text-decoration: none; } .quote figcaption a:hover { text-decoration: underline; }

  .cloud { list-style: none; margin: auto 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 6px; }
  .cloud li { transform: rotate(var(--r, 0deg)); transition: transform 0.2s; }
  .cloud li:has(:hover, :focus-visible) { transform: none; }
  .cloud .pill i { background: #b9b5ab; }
  .cloud .pill:hover { box-shadow: 0 0 0 2px var(--ink); }

  .search { grid-column: span 2; justify-content: space-between; }
  .field { display: flex; gap: 8px; background: #fff; border-radius: 999px; padding: 6px; max-width: 34rem; }
  .field input { flex: 1; min-width: 0; border: 0; background: none; font: 500 16px var(--sans); color: var(--ink); padding: 0 14px; }
  .field input:focus { outline: none; }
  .field:focus-within { box-shadow: 0 0 0 2px var(--ink); }
  .field button { border: 0; border-radius: 999px; background: var(--ink); color: #fff; font: 700 15px var(--sans); padding: 12px 22px; cursor: pointer; }

  @media (prefers-reduced-motion: reduce) { .cloud li { transform: none; transition: none; } }
  @media (max-width: 760px) {
    .bento { grid-template-columns: minmax(0, 1fr); grid-auto-rows: auto; }
    .hero, .search { grid-column: auto; grid-row: auto; }
    .tile { padding: 24px; border-radius: 22px; }
  }
</style>
