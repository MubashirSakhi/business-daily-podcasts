---
import { getHighlights, slug, url } from '../lib';
type Edition = Awaited<ReturnType<typeof import('../lib').getEditions>>[number];
interface Props { latest: Edition; }
const { latest } = Astro.props;

const all = await getHighlights();
const countBy = (keys: string[]) =>
  [...keys.reduce((m, k) => m.set(k, (m.get(k) ?? 0) + 1), new Map<string, number>())].sort((a, b) => b[1] - a[1]);
const topics = countBy(all.flatMap((h) => h.topics)).slice(0, 8);
const tags = countBy(all.map((h) => h.category));

const lead = latest.episodes[0];
const n = latest.episodes.length;
const d = new Date(latest.date + 'T12:00:00Z');
const fmt = (o: Intl.DateTimeFormatOptions) => d.toLocaleDateString('en-US', { ...o, timeZone: 'UTC' });
---
<section class="read" aria-label="Today's read">
  <p class="read-meta"><span class="read-pill">Today's read</span> <span>{fmt({ weekday: 'long', month: 'long', day: 'numeric' })} · {n} recaps</span></p>
  <h2>{latest.lead_headline ?? lead.title}</h2>
  {latest.lead_dek && <p class="dek">{latest.lead_dek}</p>}
  <a class="btn dark" href={url(latest.path)}>Start reading →</a>
</section>

<section class="today">
  <h1>{fmt({ weekday: 'long' })} <a href={url(latest.path)}>{fmt({ month: 'long', day: 'numeric' })}</a></h1>
  <ul class="eps">
    {latest.episodes.map((ep) => <li><a href={url(ep.path)}>{ep.title}</a> <span>{ep.show}</span></li>)}
  </ul>
  <a class="btn light" href={url(latest.path)}>Read the {n} recaps →</a>

  <figure class="qotd">
    <div class="qshow">{lead.show}</div>
    <blockquote>“{lead.highlights[0].text}”</blockquote>
    <figcaption><a href={url(lead.path)}>{lead.title}</a></figcaption>
  </figure>
</section>

<nav class="block first" aria-labelledby="h-topics">
  <h2 id="h-topics">What the shows keep coming back to</h2>
  <ul class="pills">
    {topics.map(([t, c]) => <li><a class="pill topic" href={url(`topics/${slug(t)}/`)}>{t}<span>{c} highlights</span></a></li>)}
  </ul>
</nav>

<nav class="block" aria-labelledby="h-tags">
  <h2 id="h-tags">Browse by tag</h2>
  <ul class="pills">
    {tags.map(([t, c]) => <li><a class="pill tag" href={url(`tags/${slug(t)}/`)}>{t}<span>{c}</span></a></li>)}
  </ul>
</nav>

<form class="block" action={url('search/')} method="get" role="search">
  <h2><label for="hq">Search every recap and highlight</label></h2>
  <div class="field">
    <input id="hq" name="q" type="search" placeholder="Search recaps and highlights" required />
    <button class="btn light" type="submit">Search</button>
  </div>
</form>

<style>
  .read { margin-top: clamp(16px, 3vw, 32px); padding: clamp(28px, 4vw, 48px); border-radius: 28px; background: var(--orange); color: var(--on-dark); }
  .read-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin: 0;
    font: 700 13px var(--sans); letter-spacing: 0.06em; text-transform: uppercase; color: #3d1000; }
  .read-pill { padding: 4px 12px; border-radius: 999px; background: var(--on-dark); color: #ffb694; }
  .read h2 { font: 700 clamp(30px, 4.6vw, 48px)/1.05 var(--sans); letter-spacing: -0.025em; margin: 18px 0 14px; text-wrap: pretty; }
  .dek { margin: 0 0 24px; max-width: 58ch; font: 500 clamp(16px, 1.8vw, 19px)/1.5 var(--sans); color: #2a0b00; text-wrap: pretty; }

  .btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px; border: 0; border-radius: 999px;
    font: 600 16px var(--sans); text-decoration: none; cursor: pointer; }
  .btn.dark { background: var(--on-dark); color: var(--ink); }
  .btn.dark:hover { background: #3d1000; color: var(--ink); }
  .btn.light { background: var(--ink); color: var(--on-dark); }
  .btn.light:hover { background: var(--accent); color: var(--on-dark); }

  .today { padding-top: clamp(40px, 6vw, 64px); }
  .today h1 { font: 700 clamp(38px, 6vw, 60px)/1 var(--sans); letter-spacing: -0.03em; margin: 0 0 20px; }
  .today h1 a { color: var(--accent); text-decoration: none; }
  .eps { list-style: none; margin: 0; padding: 0; }
  .eps li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; padding: 12px 0; }
  .eps a { font: 600 clamp(18px, 2vw, 21px)/1.3 var(--sans); text-decoration: none; text-wrap: pretty; }
  .eps span { font: 14px var(--sans); color: var(--muted); }
  .eps + .btn { margin-top: 16px; }

  .qotd { margin: clamp(40px, 6vw, 64px) 0 0; padding-left: clamp(20px, 3vw, 28px); border-left: 4px solid var(--orange); }
  .qshow { font: 600 14px var(--sans); color: var(--accent); margin-bottom: 10px; }
  .qotd blockquote { margin: 0 0 14px; font: 600 clamp(22px, 2.8vw, 30px)/1.3 var(--sans); letter-spacing: -0.01em; text-wrap: pretty; }
  .qotd figcaption { font: italic 15px var(--sans); color: var(--secondary); }
  .qotd figcaption a { color: inherit; }

  .block { margin-top: 44px; }
  .block.first { margin-top: clamp(56px, 8vw, 88px); }
  .block h2 { font: 700 clamp(22px, 2.6vw, 28px)/1.2 var(--sans); margin: 0 0 14px; }
  .pills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pill { display: flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: 999px;
    font: 600 15px var(--sans); text-decoration: none; }
  .pill span { font-size: 13px; font-weight: 500; }
  .pill.topic { background: var(--chip); }
  .pill.topic:hover { background: #3a2318; color: var(--ink); }
  .pill.topic span { color: var(--muted); }
  .pill.tag { border: 1.5px solid var(--border); }
  .pill.tag:hover { border-color: var(--lime); color: var(--ink); }
  .pill.tag span { color: var(--lime); }

  .field { display: flex; flex-wrap: wrap; gap: 8px; }
  .field input { flex: 1 1 240px; min-height: 48px; padding: 0 20px; border-radius: 999px; border: 1.5px solid var(--border);
    background: var(--card); color: var(--ink); font: 16px var(--sans); }
  .field input::placeholder { color: var(--muted); }
</style>
