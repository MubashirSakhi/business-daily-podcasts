---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import { getEditions, url } from '../lib';

// Page 1 is the homepage: today's edition plus the 6 before it. Older pages hold 12 each.
export const getStaticPaths = (async () => {
  const eds = await getEditions();
  const chunks = [eds.slice(0, 7)];
  for (let i = 7; i < eds.length; i += 12) chunks.push(eds.slice(i, i + 12));
  return chunks.map((data, k) => ({ params: { page: k ? String(k + 1) : undefined }, props: { data, currentPage: k + 1, lastPage: chunks.length } }));
}) satisfies GetStaticPaths;

const { data, currentPage, lastPage } = Astro.props;
const day = (date: string, opts: Intl.DateTimeFormatOptions) =>
  new Date(date + 'T12:00:00Z').toLocaleDateString('en-US', { ...opts, timeZone: 'UTC' });
const first = currentPage === 1;
const past = first ? data.slice(1) : data;
const pageUrl = (n: number) => url(n === 1 ? '' : `${n}/`);
---
<Base wide title={first ? undefined : `Editions, page ${currentPage}`}>
  {first ? <Home latest={data[0]} /> : <h1 class="visually-hidden">Editions, page {currentPage}</h1>}
  <section class="past">
    {past.length > 0 && <h2>{first ? 'Past editions' : `Editions, page ${currentPage}`}</h2>}
    <ol class="editions">
      {past.map((ed) => {
        const tags = [...ed.episodes.flatMap((ep) => ep.highlights.map((h) => h.category))
          .reduce((m, t) => m.set(t, (m.get(t) ?? 0) + 1), new Map<string, number>())].sort((x, y) => y[1] - x[1]).slice(0, 2);
        const words = ed.episodes.flatMap((ep) => [...ep.recap, ...ep.fun_facts, ...ep.discussion_questions]).join(' ').split(/\s+/).length;
        const n = ed.episodes.length;
        return (
          <li>
            <a class="ed" href={url(ed.path)}>
              <span class="top">
                <span class="when">{day(ed.date, { weekday: 'long', month: 'long', day: 'numeric' })}</span>
                <span class="meta">{n} episode{n === 1 ? '' : 's'} · {Math.max(1, Math.round(words / 230))} min read</span>
              </span>
              <span class="tags">{tags.map(([t]) => <span>{t}</span>)}</span>
              <ul>{ed.episodes.slice(0, 3).map((ep) => <li>{ep.title}</li>)}</ul>
              <span class="go">{n > 3 && `+${n - 3} more · `}Read the edition →</span>
            </a>
          </li>
        );
      })}
    </ol>

    {first ? lastPage > 1 && <a class="older" href={pageUrl(2)}>Older editions →</a> : (
      <nav class="pager" aria-label="Editions pages">
        {currentPage > 1 ? <a href={pageUrl(currentPage - 1)}>Newer</a> : <span />}
        <ol>
          {Array.from({ length: lastPage }, (_, k) => k + 1).map((n) => (
            <li>{n === currentPage
              ? <span aria-current="page">{n}</span>
              : <a href={pageUrl(n)}>{n}</a>}</li>
          ))}
        </ol>
        {currentPage < lastPage ? <a href={pageUrl(currentPage + 1)}>Older</a> : <span />}
      </nav>
    )}
  </section>
</Base>

<style>
  .past { margin-top: clamp(56px, 8vw, 88px); }
  .past h2 { font: 700 clamp(22px, 2.6vw, 28px)/1.2 var(--sans); margin: 0 0 16px; }
  .editions { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr)); gap: 14px; }
  .editions > li { min-width: 0; }

  .ed { display: flex; flex-direction: column; gap: 12px; height: 100%; padding: 22px; border-radius: 28px; text-decoration: none;
    background: var(--card); box-shadow: 0 0 0 1px var(--rule); font-family: var(--sans); }
  .ed:hover { box-shadow: 0 0 0 1px var(--border); color: var(--ink); }
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .when { font-size: 18px; font-weight: 700; }
  .meta { font-size: 13px; color: var(--muted); white-space: nowrap; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tags span { padding: 3px 10px; border-radius: 999px; background: #26301a; color: #d9f99d; font-size: 12px; font-weight: 600; }
  .ed ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 15px; line-height: 1.35; text-wrap: pretty; }
  .go { margin-top: auto; font-size: 14px; font-weight: 600; color: var(--accent); }

  .older { display: inline-flex; align-items: center; margin-top: 18px; min-height: 44px; padding: 0 20px; border-radius: 999px;
    border: 1.5px solid var(--border); font: 600 15px var(--sans); text-decoration: none; }

  .pager { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 40px;
    padding-top: 16px; border-top: 1px solid var(--rule); font: 500 14px var(--sans); }
  .pager ol { display: flex; gap: 4px; list-style: none; padding: 0; margin: 0; }
  .pager ol a, .pager ol span { display: inline-block; min-width: 2em; padding: 4px 6px; text-align: center; text-decoration: none; }
  .pager [aria-current] { background: var(--ink); color: var(--paper); border-radius: 999px; }
  .pager > a { text-decoration: none; color: var(--muted); }

  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
