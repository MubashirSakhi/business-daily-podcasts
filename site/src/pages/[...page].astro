---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import EditionBento from '../components/EditionBento.astro';
import { getEditions, SHOW_BADGE, url } from '../lib';

export const getStaticPaths = (async ({ paginate }) => paginate(await getEditions(), { pageSize: 12 })) satisfies GetStaticPaths;

const { page } = Astro.props;
const day = (date: string, opts: Intl.DateTimeFormatOptions) =>
  new Date(date + 'T12:00:00Z').toLocaleDateString('en-US', { ...opts, timeZone: 'UTC' });
const first = page.currentPage === 1;
const past = first ? page.data.slice(1) : page.data;
const pageUrl = (n: number) => url(n === 1 ? '' : `${n}/`);
---
<Base wide title={first ? undefined : `Editions, page ${page.currentPage}`}>
  {first ? <EditionBento latest={page.data[0]} /> : <h1 class="visually-hidden">Editions, page {page.currentPage}</h1>}
  {past.length > 0 && <h2 class="past-title">{first ? 'Past editions' : `Editions, page ${page.currentPage}`}</h2>}
  <ol class="editions">
    {past.map((ed, i) => {
      const shows = [...new Set(ed.episodes.map((ep) => ep.show))];
      const tags = [...ed.episodes.flatMap((ep) => ep.highlights.map((h) => h.category))
        .reduce((m, t) => m.set(t, (m.get(t) ?? 0) + 1), new Map<string, number>())].sort((x, y) => y[1] - x[1]).slice(0, 2);
      const words = ed.episodes.flatMap((ep) => [...ep.recap, ...ep.fun_facts, ...ep.discussion_questions]).join(' ').split(/\s+/).length;
      const n = ed.episodes.length;
      return (
        <li style={`--i:${Math.min(i, 8)}`}>
          <a class="ed" href={url(ed.path)}>
            <div class="cover dots" aria-hidden="true">
              <div class="stripes">{ed.episodes.map((ep) => <span class={SHOW_BADGE[ep.show]} />)}</div>
              <span class="dd">{day(ed.date, { day: 'numeric' })}</span>
              <div class="glass-tags">{tags.map(([t]) => <span class="glass">{t}</span>)}</div>
              <div class="veil"><span class="read"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v14M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>Read the edition</span></div>
            </div>
            <div class="body">
              <h3>{day(ed.date, { weekday: 'long', month: 'long', day: 'numeric' })}</h3>
              <ul class="ed-eps">
                {ed.episodes.slice(0, 3).map((ep) => <li>{ep.title}</li>)}
                {n > 3 && <li class="more">+{n - 3} more</li>}
              </ul>
              <div class="foot">
                <span class="who">
                  <span class="stack" aria-hidden="true">{shows.map((sh) => <i class={SHOW_BADGE[sh]} />)}</span>
                  <span><b>{n} episodes</b><br />{day(ed.date, { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                </span>
                <span class="time"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>{Math.max(1, Math.round(words / 230))} min read</span>
              </div>
            </div>
          </a>
        </li>
      );
    })}
  </ol>

  {page.lastPage > 1 && (
    <nav class="pager" aria-label="Editions pages">
      {page.url.prev ? <a href={page.url.prev}>Newer</a> : <span />}
      <ol>
        {Array.from({ length: page.lastPage }, (_, k) => k + 1).map((n) => (
          <li>{n === page.currentPage
            ? <span aria-current="page">{n}</span>
            : <a href={pageUrl(n)}>{n}</a>}</li>
        ))}
      </ol>
      {page.url.next ? <a href={page.url.next}>Older</a> : <span />}
    </nav>
  )}
</Base>

<style>
  .past-title { font: 700 1.6rem var(--sans); letter-spacing: -0.02em; margin: 56px 0 20px; }
  .editions { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); gap: 20px; }
  .editions > li { min-width: 0; animation: rise 0.4s ease-out backwards; animation-delay: calc(var(--i) * 60ms); }
  @keyframes rise { from { opacity: 0; transform: translateY(20px); } }

  .ed { display: flex; flex-direction: column; height: 100%; overflow: hidden; border-radius: 20px; text-decoration: none;
    background: rgb(255 255 255 / 0.7); border: 1px solid rgb(28 36 51 / 0.08);
    box-shadow: 0 1px 2px rgb(28 36 51 / 0.05), 0 10px 28px -16px rgb(28 36 51 / 0.2);
    transition: border-color 0.3s, box-shadow 0.3s; }
  .ed:hover, .ed:focus-visible { border-color: rgb(47 74 122 / 0.45);
    box-shadow: 0 2px 4px rgb(28 36 51 / 0.05), 0 22px 44px -18px rgb(47 74 122 / 0.35); }

  .cover { position: relative; aspect-ratio: 16 / 9; overflow: hidden; }
  .stripes { position: absolute; inset: 0; display: flex; transition: transform 0.5s ease-out; }
  .stripes span { flex: 1; background: var(--show); }
  .cover.dots::after { content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(rgb(28 36 51 / 0.1) 1px, transparent 1.4px) 0 0 / 11px 11px; }
  .ed:hover .stripes, .ed:focus-visible .stripes { transform: scale(1.1); }
  .dd { position: absolute; top: 14px; left: 18px; z-index: 1; font: 800 4.2rem/0.9 var(--sans); letter-spacing: -0.05em; color: var(--ink); }

  .glass-tags { position: absolute; left: 12px; bottom: 12px; z-index: 1; display: flex; gap: 6px; flex-wrap: wrap; }
  .glass { font: 600 12px/1 var(--sans); padding: 6px 10px; border-radius: 999px; color: var(--ink);
    background: rgb(255 255 255 / 0.5); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); border: 1px solid rgb(255 255 255 / 0.6); }

  .veil { position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; opacity: 0; transition: opacity 0.3s;
    background: rgb(246 245 241 / 0.25); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); }
  .ed:hover .veil, .ed:focus-visible .veil { opacity: 1; }
  .read { display: inline-flex; align-items: center; gap: 8px; padding: 11px 22px; border-radius: 999px; background: var(--ink); color: #fff;
    font: 700 14px var(--sans); box-shadow: 0 8px 20px -6px rgb(28 36 51 / 0.45); transform: scale(0.94); transition: transform 0.3s; }
  .ed:hover .read, .ed:focus-visible .read { transform: scale(1); }

  .body { display: flex; flex-direction: column; gap: 12px; padding: 18px 20px 16px; flex: 1; }
  .body h3 { font: 700 1.25rem/1.2 var(--sans); letter-spacing: -0.02em; text-transform: none; margin: 0; color: var(--ink); transition: color 0.3s; }
  .ed:hover h3, .ed:focus-visible h3 { color: var(--accent); }
  .ed-eps { list-style: none; padding: 0; margin: 0; font: 400 15px/1.4 var(--serif); color: var(--muted); }
  .ed-eps li { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ed-eps .more { font: 600 12px/1.8 var(--sans); }

  .foot { margin-top: auto; padding-top: 14px; border-top: 1px solid var(--rule); display: flex; align-items: center; justify-content: space-between; gap: 8px;
    font: 500 12px/1.35 var(--sans); color: var(--muted); }
  .foot b { color: var(--ink); font-weight: 600; }
  .who { display: flex; align-items: center; gap: 10px; }
  .stack { display: flex; }
  .stack i { width: 26px; height: 26px; border-radius: 50%; background: var(--show); border: 2px solid #fff; margin-left: -9px; }
  .stack i:first-child { margin-left: 0; }
  .time { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }

  @media (prefers-reduced-motion: reduce) {
    .editions > li { animation: none; }
    .stripes, .read, .veil { transition: none; }
    .ed:hover .stripes, .ed:focus-visible .stripes { transform: none; }
  }

  .pager { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 40px;
    padding-top: 16px; border-top: 1px solid var(--rule); font: 500 14px var(--sans); }
  .pager ol { display: flex; gap: 4px; list-style: none; padding: 0; margin: 0; }
  .pager ol a, .pager ol span { display: inline-block; min-width: 2em; padding: 4px 6px; text-align: center; text-decoration: none; }
  .pager [aria-current] { background: var(--ink); color: var(--paper); border-radius: 999px; }
  .pager > a { text-decoration: none; color: var(--muted); }
  .pager > a:hover, .pager ol a:hover { color: var(--ink); text-decoration: underline; }

  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
